# Public URL of the app (used for share links, QR codes and link previews)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database: local SQLite file by default. For production use Turso (libSQL):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/app.db

# First admin account (created on first start if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Optional: WhatsApp number that receives invitation orders from the landing page
# NEXT_PUBLIC_ORDER_WHATSAPP=9665xxxxxxxx
